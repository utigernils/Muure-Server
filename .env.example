# Server Configuration
SERVER_HOST=0.0.0.0
SERVER_PORT=8000

# OpenWeather API
OPENWEATHER_API_KEY=your_openweather_api_key_here
WEATHER_CITY=Lucerne
WEATHER_UNITS=metric

# SBB Transport API
SBB_STATION_ID=your_station_id_here
SBB_MAX_DEPARTURES=5
SBB_EXCLUDE_TO=

# Quote API
